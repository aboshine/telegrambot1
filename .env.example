# Copy this file to `.env` and fill in your values.
# Get a token from https://t.me/BotFather

BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
LOG_LEVEL=INFO

# Optional: Telegram chat id for daily reminders at 20:00 (group supergroup id, often negative)
# REMINDER_CHAT_ID=-1001234567890
REMINDER_TIMEZONE=Europe/Moscow
REMINDER_HOUR=20
REMINDER_MINUTE=0
